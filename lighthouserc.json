{
  "ci": {
    "collect": {
      "startServerCommand": "python3 -m http.server 8087",
      "startServerReadyPattern": "Serving HTTP",
      "url": [
        "http://localhost:8087/index.html",
        "http://localhost:8087/career.html",
        "http://localhost:8087/projects.html",
        "http://localhost:8087/skills.html",
        "http://localhost:8087/articles.html",
        "http://localhost:8087/faq.html",
        "http://localhost:8087/books.html",
        "http://localhost:8087/interests.html",
        "http://localhost:8087/privacy.html",
        "http://localhost:8087/404.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new",
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "comment": "404 is intentionally noindex, so the SEO is-crawlable audit (correctly) tanks its SEO score — exclude SEO here.",
          "matchingUrlPattern": ".*404\\.html$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:performance": ["warn", { "minScore": 0.8 }]
          }
        },
        {
          "comment": "All real, indexable pages: a11y must stay 100; SEO and best-practices near-100; performance advisory (CI timing is noisy).",
          "matchingUrlPattern": "^(?!.*404\\.html).*$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "categories:performance": ["warn", { "minScore": 0.8 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
